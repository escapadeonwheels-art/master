{
  "expo": {
    "name": "EscapadeOnWheels",
    "slug": "eow",
    "scheme": "%EXPO_PUBLIC_DEEP_LINK_SCHEME%",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/eow.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/eow.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/eow.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/eow.png",
      "output": "single"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
